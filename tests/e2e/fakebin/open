#!/bin/sh
# Stand-in for macOS `open`, first on PATH in every test that sources or replays
# install.sh. No test may open a real app, URL or System Settings pane on the
# machine it runs on. Logs its arguments to $FAKE_OPEN_LOG when set.
[ -n "${FAKE_OPEN_LOG:-}" ] && echo "OPEN $*" >> "$FAKE_OPEN_LOG"
exit 0

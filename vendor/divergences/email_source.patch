+def test_l3_address_map_rides_through(tmp_path):
+    mail = tmp_path / "Mail"
+    _build_two_threads(mail)
+    contacts = tmp_path / "contacts.yaml"
+    contacts.write_text(
+        "contacts:\n"
+        '  "alex@partner.test":\n'
+        '    name: "Alex Synthetic"\n'
+        '    privacy_level: "L3"\n'
+    )
+    stub = _StubDispatch()
+    cmd = stub.make_cmd(tmp_path)

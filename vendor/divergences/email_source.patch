+def _stderr_excerpt(raw):
+    """Tail of a captured stream, with an explicit marker when clipped."""
+    if raw is None:
+        return "<no stderr captured>"
+    text = raw if isinstance(raw, str) else raw.decode("utf-8", "replace")
+    text = text.strip()

@@ -0,0 +1,328 @@
+"""Orchestration for both Slack routes: build conversations, post each one
+through the CM052 wire (which hands it to CM048 for the 4-artefact bundle),
+and keep the idempotency state.
+
+Idempotency: ``state["posted"]`` maps ``conversation_id -> content digest``.
+A conversation whose digest is unchanged is not posted again, so a second
+run over the same data posts 0. An edit, a new reply or reaction, or a
+change of privacy level changes the digest and re-posts the SAME id, which
+CM048 writes into the same bundle folder (no duplicate).
+
+Failure accounting (poison vs outage): a conversation that raised is
+``failed`` and is NOT recorded, so the next run retries it. ``paused``
+(subscription gate) is also not recorded. On the API route a channel's
+cursor advances only when every conversation from it was recorded.
+"""
+from __future__ import annotations
+
+import json
+import logging
+import os
+from collections import Counter
+from collections.abc import Callable
+from datetime import datetime, timezone
+from pathlib import Path
+
+from .. import wire
+from ..schemas import Conversation
+from . import model
+from .api import SlackApiError, SlackClient
+
+log = logging.getLogger(__name__)
+
+PostFn = Callable[[Conversation], dict]
+
+# Errors after which nothing else in the workspace can be read either.
+FATAL_API_ERRORS = frozenset({
+    "invalid_auth", "not_authed", "token_revoked", "token_expired",
+    "account_inactive", "missing_scope", "no_permission", "ekm_access_denied",
+})
+
+
+def state_path() -> Path:
+    raw = os.environ.get("CM052_STATE_DIR") or "~/.pwg/cm052"
+    return Path(raw).expanduser() / "slack_state.json"
+
+
+def load_state(path: Path) -> dict:
+    empty = {"posted": {}, "cursors": {}, "workspaces": {}}
+    if not path.is_file():
+        return empty
+    try:
+        data = json.loads(path.read_text(encoding="utf-8"))
+    except (OSError, ValueError):
+        log.warning("slack state unreadable; starting empty (re-post is idempotent)")
+        return empty
+    for key in empty:
+        if not isinstance(data.get(key), dict):
+            data[key] = {}
+    return data
+
+
+def save_state(path: Path, state: dict) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    tmp = path.with_suffix(".tmp")
+    tmp.write_text(json.dumps(state, indent=2, sort_keys=True), encoding="utf-8")
+    tmp.replace(path)
+
+
+def day_zone(state: dict):
+    """The zone Slack days are cut in: the owner's, fixed at first import.
+
+    Red team, 19 Oct: days were cut at UTC midnight, so for a UTC+8 owner a
+    working day was split at 8am and the morning filed under yesterday. The
+    zone is recorded in the state on first use and reused after, because a
+    day unit's id contains its date: re-deriving it on every run would mint
+    new ids (duplicate bundles) the first time the owner travelled.
+    Order: recorded; ``OSTLER_TIMEZONE``; ``TZ``; the Mac's /etc/localtime;
+    UTC.
+    """
+    from zoneinfo import ZoneInfo, ZoneInfoNotFoundError
+
+    def _zone(name):
+        try:
+            return ZoneInfo(name) if name else None
+        except (ZoneInfoNotFoundError, ValueError):
+            return None
+
+    recorded = _zone(state.get("day_tz"))
+    if recorded is not None:
+        return recorded
+    candidates = [os.environ.get("OSTLER_TIMEZONE"), os.environ.get("TZ")]
+    try:
+        target = os.path.realpath("/etc/localtime")
+        if "zoneinfo/" in target:
+            candidates.append(target.split("zoneinfo/", 1)[1])
+    except OSError:
+        pass
+    for name in candidates:
+        zone = _zone(name)
+        if zone is not None:
+            state["day_tz"] = name
+            return zone
+    state["day_tz"] = "UTC"
+    return ZoneInfo("UTC")
+
+
+def privacy_level() -> str | None:
+    return model.resolve_privacy_level(os.environ.get("OSTLER_SLACK_PRIVACY_LEVEL"))
+
+
+def new_counts() -> dict:
+    return {
+        "conversations": 0, "posted": 0, "unchanged": 0, "l3_files_only": 0,
+        "paused": 0, "failed": 0,
+    }
+
+
+def post_all(
+    convs: list[Conversation], state: dict, post_fn: PostFn, counts: dict,
+    *, dry_run: bool = False,
+) -> bool:
+    """Post new/changed conversations. Returns True when every one of them
+    is now recorded (or unchanged)."""
+    all_ok = True
+    for conv in convs:
+        counts["conversations"] += 1
+        d = model.digest(conv)
+        if state["posted"].get(conv.conversation_id) == d:
+            counts["unchanged"] += 1
+            continue
+        if dry_run:
+            counts["posted"] += 1
+            continue
+        try:
+            result = post_fn(conv) or {}
+        except Exception as exc:  # one bad conversation never aborts the run
+            log.warning("slack: post failed for %s: %s", conv.conversation_id, type(exc).__name__)
+            counts["failed"] += 1
+            all_ok = False
+            continue
+        status = result.get("status")
+        if status == "paused":
+            counts["paused"] += 1
+            all_ok = False
+            continue
+        # ``posted`` = handed to CM048. ``l3_files_only`` is the subset at L3:
+        # CM048 writes the 4-artefact bundle and skips the gist.
+        counts["posted"] += 1
+        if result.get("gist_level") == "L3" or result.get("reason") == "privacy_level_l3":
+            counts["l3_files_only"] += 1
+        state["posted"][conv.conversation_id] = d
+    return all_ok
+
+
+# ---------------------------------------------------------------------------
+# Route 1: export
+# ---------------------------------------------------------------------------
+
+
+class OwnerUnknown(Exception):
+    """The export route could not tell which Slack account is the owner's.
+
+    Red team, 19 Oct: this used to carry on with ``self_id=None``, so every
+    one of the owner's own messages was attributed to "a participant" and the
+    owner became a contact in their own People graph. Now it refuses before
+    anything is posted."""
+
+
+def resolve_export_owner(
+    users: dict, raw_users: list[dict], state: dict, *,
+    self_user_id: str | None, self_emails: list[str],
+) -> tuple[str, str]:
+    """Return ``(user_id, how)``. Order: an explicit ``--self-user-id``; the
+    user id ``token-set`` recorded for the SAME workspace (``auth.test``, an
+    authoritative answer); then an email match. Raises ``OwnerUnknown``."""
+    if self_user_id:
+        if self_user_id in users:
+            return self_user_id, "flag"
+        raise OwnerUnknown("that Slack member ID is not in this export")
+    teams = {u.get("team_id") for u in raw_users if isinstance(u, dict) and u.get("team_id")}
+    for team, ws in (state.get("workspaces") or {}).items():
+        uid = (ws or {}).get("user_id")
+        if team in teams and uid in users:
+            return uid, "token"
+    wanted = {e.strip().lower() for e in self_emails if e and e.strip()}
+    hits = [u.user_id for u in users.values() if u.email and u.email in wanted]
+    if len(hits) == 1:
+        return hits[0], "email"
+    if len(hits) > 1:
+        raise OwnerUnknown("more than one Slack account in this export uses your email")
+    raise OwnerUnknown("none of the accounts in this export uses your email")
+
+
+def import_export(
+    path: Path, *, self_email: str | None, state: dict,
+    post_fn: PostFn = wire.post, dry_run: bool = False,
+    self_user_id: str | None = None, extra_emails: list[str] | None = None,
+) -> dict:
+    from .export_zip import ExportReader
+
+    counters = model.ImportCounters()
+    counts = new_counts()
+    with ExportReader(path) as reader:
+        users = model.parse_users(reader.users)
+        self_id, how = resolve_export_owner(
+            users, reader.users, state, self_user_id=self_user_id,
+            self_emails=[self_email or "", *(extra_emails or [])],
+        )
+        ctx = model.BuildContext(
+            users=users, self_user_id=self_id, privacy_level=privacy_level(),
+            route="export", day_tz=day_zone(state),
+        )
+        # Streamed: one channel in memory at a time.
+        for _folder, info, msgs in reader.iter_folders():
+            convs = model.build_conversations(info, msgs, ctx, counters)
+            post_all(convs, state, post_fn, counts, dry_run=dry_run)
+        counts.update({
+            "route": "export",
+            "containers": dict(reader.kinds),
+            "unmatched_folders": reader.unmatched_folders,
+            "skipped_files": reader.skipped_files,
+            "bad_day_files": reader.bad_day_files,
+            "owner_found_by": how,
+            "messages": counters.to_dict(),
+        })
+    return counts
+
+
+# ---------------------------------------------------------------------------
+# Route 2: owner's internal-app user token
+# ---------------------------------------------------------------------------
+
+
+def _kind(conv: dict) -> str:
+    if conv.get("is_im"):
+        return "im"
+    if conv.get("is_mpim"):
+        return "mpim"
+    if conv.get("is_private") or conv.get("is_group"):
+        return "private"
+    return "public"
+
+
+def _day_floor(epoch: float, zone=timezone.utc) -> float:
+    d = datetime.fromtimestamp(max(epoch, 0), tz=zone)
+    return d.replace(hour=0, minute=0, second=0, microsecond=0).timestamp()
+
+
+def sync_api(
+    client: SlackClient, *, state: dict, post_fn: PostFn = wire.post,
+    rescan_days: int = 7, dry_run: bool = False,
+    save: Callable[[dict], None] | None = None,
+) -> dict:
+    """Backfill on first run (``oldest=0``), then incremental.
+
+    Each run re-reads from the start of the owner's day ``rescan_days`` before
+    the channel's cursor, so day conversations are always rebuilt whole and
+    edits/reactions/replies inside the window are picked up. A reply to a
+    thread whose root is older than the window is NOT seen (documented
+    limit; ``--rescan-days`` widens it).
+    """
+    me = client.auth_test()
+    team = str(me.get("team_id") or "")
+    self_id = me.get("user_id")
+    state["workspaces"][team] = {"team": me.get("team"), "user_id": self_id}
+    users = model.parse_users(client.users())
+    zone = day_zone(state)
+    ctx = model.BuildContext(
+        users=users, self_user_id=self_id, privacy_level=privacy_level(),
+        route="api", workspace=me.get("team"), day_tz=zone,
+    )
+    counters = model.ImportCounters()
+    counts = new_counts()
+    channel_errors: Counter = Counter()
+    channels = client.my_conversations()
+    for raw in channels:
+        cid = raw.get("id")
+        if not isinstance(cid, str):
+            continue
+        kind = _kind(raw)
+        members: list[str] = []
+        if kind == "im":
+            members = [m for m in (self_id, raw.get("user")) if isinstance(m, str)]
+        elif kind == "mpim":
+            try:
+                # An MPIM has at most 9 members: one page is the whole list.
+                payload = client.call("conversations.members", {"channel": cid, "limit": 200})
+                members = [m for m in payload.get("members") or [] if isinstance(m, str)]
+            except SlackApiError:
+                members = []
+        info = model.ChannelInfo(
+            channel_id=cid, name=str(raw.get("name") or cid), kind=kind, members=members,
+        )
+        key = f"{team}:{cid}"
+        cursor = state["cursors"].get(key)
+        oldest = "0" if cursor is None else str(
+            int(_day_floor(model.ts_float(cursor) - rescan_days * 86400, zone))
+        )
+        try:
+            msgs = client.history(cid, oldest)
+            for m in list(msgs):
+                if (m.get("reply_count") or 0) > 0 and m.get("ts"):
+                    msgs.extend(client.replies(cid, m["ts"]))
+        except SlackApiError as exc:
+            if exc.error in FATAL_API_ERRORS:
+                raise
+            channel_errors[exc.error] += 1
+            continue
+        for uid in {m.get("user") for m in msgs if isinstance(m.get("user"), str)} - set(users):
+            raw_user = client.user_info(uid)
+            parsed = model.parse_user(raw_user) if raw_user else None
+            if parsed:
+                users[uid] = parsed
+        convs = model.build_conversations(info, msgs, ctx, counters)
+        ok = post_all(convs, state, post_fn, counts, dry_run=dry_run)
+        if ok and msgs and not dry_run:
+            newest = max((str(m.get("ts")) for m in msgs if m.get("ts")), key=model.ts_float)
+            state["cursors"][key] = newest
+        if save and not dry_run:
+            save(state)
+    counts.update({
+        "route": "api",
+        "channels": len(channels),
+        "channel_errors": dict(channel_errors),
+        "api_calls": client.calls,
+        "messages": counters.to_dict(),
+    })
+    return counts
diff --git b/src/cm052/slack/keychain.py b/src/cm052/slack/keychain.py
new file mode 100644
index 00000000..cce2d4cd
--- /dev/null
+++ b/src/cm052/slack/keychain.py
@@ -0,0 +1,83 @@
+"""Slack user token in the login Keychain, via ``/usr/bin/security``.
+
+There is no shared Python Keychain helper in the PWG repos (searched
+CM048, CM052, CM041, CM046, CM019 for ``generic-password`` / ``keyring``:
+zero hits; the only Keychain writer is install.sh's Swift helper for the
+recovery key). This module is that helper for the importers.
+
+Rules it keeps, each from an incident:
+
+- The token is NEVER on argv (install.sh v1.0.109: ``security
+  add-generic-password -w <key>`` put a secret in ``ps`` output). Writes go
+  through ``security -i``, which reads the command from STDIN.
+- ``security -i`` exits 0 even when its command fails (measured for
+  install.sh), so a write is only reported saved after a read-back returns
+  the identical value.
+- The token is validated against a strict shape before it is written, which
+  also means it cannot carry a quote or newline into the ``-i`` command line.
+- Reads use ``find-generic-password -w``: the value comes back on stdout.
+
+Known gap for review: ``security`` cannot set
+``kSecAttrAccessibleWhenUnlockedThisDeviceOnly``; the Swift helper in
+install.sh can. The item is in the login Keychain, not synchronised.
+
+Tests never touch a real Keychain: ``runner`` is injectable, and the PATH
+stub test replaces ``security`` itself.
+"""
+from __future__ import annotations
+
+import re
+import subprocess
+from collections.abc import Callable
+
+SERVICE = "Ostler Slack Token"
+SECURITY = "security"
+
+_TOKEN_SHAPE = re.compile(r"^xoxp-[A-Za-z0-9-]{20,250}$")
+_ACCOUNT_SHAPE = re.compile(r"^[TE][A-Z0-9]{2,20}$")
+
+Runner = Callable[..., subprocess.CompletedProcess]
+
+
+class SecretStoreError(Exception):
+    pass
+
+
+def valid_token(token: str) -> bool:
+    return bool(_TOKEN_SHAPE.match(token or ""))
+
+
+def _check_account(team_id: str) -> None:
+    if not _ACCOUNT_SHAPE.match(team_id or ""):
+        raise SecretStoreError("workspace id has an unexpected shape")
+
+
+def store_token(team_id: str, token: str, runner: Runner = subprocess.run) -> None:
+    if not valid_token(token):
+        # Never echo the value back, not even a prefix.
+        raise SecretStoreError(
+            "that does not look like a Slack user token (expected xoxp-...)"
+        )
+    _check_account(team_id)
+    command = (
+        f'add-generic-password -U -s "{SERVICE}" -a "{team_id}" -w "{token}"\n'
+    )
+    proc = runner(
+        [SECURITY, "-i"], input=command, capture_output=True, text=True, check=False
+    )
+    if proc.returncode != 0:
+        raise SecretStoreError("Keychain write failed")
+    if load_token(team_id, runner=runner) != token:
+        raise SecretStoreError("Keychain write could not be verified by read-back")
+
+
+def load_token(team_id: str, runner: Runner = subprocess.run) -> str | None:
+    _check_account(team_id)
+    proc = runner(
+        [SECURITY, "find-generic-password", "-s", SERVICE, "-a", team_id, "-w"],
+        capture_output=True, text=True, check=False,
+    )
+    if proc.returncode != 0:
+        return None
+    value = (proc.stdout or "").strip()
+    return value or None
diff --git b/src/cm052/slack/model.py b/src/cm052/slack/model.py
new file mode 100644
index 00000000..74ed1895
--- /dev/null
+++ b/src/cm052/slack/model.py
@@ -0,0 +1,490 @@
+"""Shared Slack normalisation: raw Slack message objects -> ``Conversation``.
+
+Both import routes (the workspace export ZIP and the owner's own internal-app
+user token) produce the SAME raw message shape, because the export is a dump
+of the same Web API objects. Everything route-independent lives here, so the
+two routes cannot drift: the same message yields the same conversation id,
+the same transcript and the same participant rows whichever route read it
+(``tests/test_slack_routes_align.py`` proves it).
+
+Conversation units (the 4-artefact spec is written per unit by CM048):
+
+- a THREAD (root plus every reply) is one conversation, keyed by
+  ``(channel_id, thread_ts)``;
+- top-level messages with no replies are grouped into one conversation per
+  channel per day in the owner's zone (fixed at first import), keyed by
+  ``(channel_id, YYYY-MM-DD)``.
+
+Logic ported from the ZeroClaw Slack channel
+(ostler-assistant ``crates/zeroclaw-channels/src/slack.rs``): the display-name
+precedence (``extract_user_display_name``) and the supported-subtype set
+(``is_supported_message_subtype``: none, ``file_share``, ``thread_broadcast``).
+Unlike the channel, an unsupported subtype is never dropped silently: it is
+counted per subtype in ``ImportCounters.skipped_subtypes``.
+
+File handling is METADATA ONLY. Slack file objects carry ``url_private`` /
+``url_private_download`` links, and export links embed a ``?t=xoxe-...``
+token. No URL is ever copied into a transcript, metadata or log.
+"""
+from __future__ import annotations
+
+import hashlib
+import html
+import json
+import re
+from collections import Counter
+from dataclasses import dataclass, field
+from datetime import datetime, timezone, tzinfo
+from typing import Any, Iterable
+
+from ..provenance import ConversationProvenance
+from ..schemas import Conversation, Message
+
+
+SOURCE_SUBTYPE = "slack"
+_VALID_LEVELS = ("L0", "L1", "L2", "L3")
+
+# Subtypes that are a human saying something. ``me_message`` (/me) and
+# ``tombstone`` (a deleted thread root kept as a placeholder) are added to
+# the ZeroClaw set: an importer must keep a thread's shape even when its root
+# was deleted.
+_KEPT_SUBTYPES = frozenset({"", "file_share", "thread_broadcast", "me_message", "tombstone"})
+
+
+@dataclass
+class SlackUser:
+    user_id: str
+    display: str
+    email: str | None = None
+    is_bot: bool = False
+
+
+@dataclass
+class ChannelInfo:
+    """One Slack conversation container (channel, private channel, DM, MPIM)."""
+
+    channel_id: str
+    name: str
+    kind: str  # "public" | "private" | "im" | "mpim"
+    members: list[str] = field(default_factory=list)
+
+
+@dataclass
+class ImportCounters:
+    """Counts for the run summary. Counts only, never content."""
+
+    messages_seen: int = 0
+    messages_kept: int = 0
+    skipped_subtypes: Counter = field(default_factory=Counter)
+    unknown_users: int = 0
+    conversations_built: int = 0
+    malformed: int = 0
+
+    def to_dict(self) -> dict:
+        return {
+            "messages_seen": self.messages_seen,
+            "messages_kept": self.messages_kept,
+            "skipped_subtypes": dict(self.skipped_subtypes),
+            "unknown_users": self.unknown_users,
+            "conversations_built": self.conversations_built,
+            "malformed": self.malformed,
+        }
+
+
+# ---------------------------------------------------------------------------
+# Users
+# ---------------------------------------------------------------------------
+
+
+def _clean(value: Any) -> str | None:
+    if isinstance(value, str) and value.strip():
+        return value.strip()
+    return None
+
+
+def display_name(user: dict) -> str | None:
+    """Port of ZeroClaw ``extract_user_display_name`` precedence."""
+    profile = user.get("profile") if isinstance(user.get("profile"), dict) else {}
+    for candidate in (
+        profile.get("display_name"),
+        profile.get("display_name_normalized"),
+        profile.get("real_name_normalized"),
+        profile.get("real_name"),
+        user.get("real_name"),
+        user.get("name"),
+    ):
+        cleaned = _clean(candidate)
+        if cleaned:
+            return cleaned
+    return None
+
+
+def parse_user(raw: dict) -> SlackUser | None:
+    if not isinstance(raw, dict):
+        return None
+    uid = _clean(raw.get("id"))
+    if not uid:
+        return None
+    profile = raw.get("profile") if isinstance(raw.get("profile"), dict) else {}
+    email = _clean(profile.get("email"))
+    return SlackUser(
+        user_id=uid,
+        display=display_name(raw) or uid,
+        email=email.lower() if email else None,
+        is_bot=bool(raw.get("is_bot")) or uid == "USLACKBOT",
+    )
+
+
+def parse_users(raw_users: Iterable[dict]) -> dict[str, SlackUser]:
+    out: dict[str, SlackUser] = {}
+    for raw in raw_users or []:
+        user = parse_user(raw)
+        if user:
+            out[user.user_id] = user
+    return out
+
+
+# ---------------------------------------------------------------------------
+# Messages
+# ---------------------------------------------------------------------------
+
+
+@dataclass
+class NormMessage:
+    ts: str
+    thread_ts: str | None
+    user_id: str | None
+    text: str
+    reply_count: int = 0
+
+
+_USER_MENTION = re.compile(r"<@([A-Z0-9]+)(?:\|[^>]*)?>")
+_CHANNEL_MENTION = re.compile(r"<#([A-Z0-9]+)(?:\|([^>]*))?>")
+_SPECIAL = re.compile(r"<!(here|channel|everyone)(?:\|[^>]*)?>")
+_SUBTEAM = re.compile(r"<!subteam\^[A-Z0-9]+(?:\|([^>]*))?>")
+_LINK = re.compile(r"<((?:https?|mailto):[^>|]+)(?:\|([^>]*))?>")
+
+
+def render_text(text: str, users: dict[str, SlackUser]) -> str:
+    """Slack mrkdwn escapes into readable text.
+
+    ``<@U1>`` -> ``@Jane Doe``; ``<#C1|general>`` -> ``#general``;
+    ``<https://x|label>`` -> ``label (https://x)``; entities unescaped last
+    (Slack escapes only ``& < >``).
+    """
+    if not text:
+        return ""
+
+    def user_sub(m: re.Match) -> str:
+        u = users.get(m.group(1))
+        return "@" + (u.display if u else m.group(1))
+
+    out = _USER_MENTION.sub(user_sub, text)
+    out = _CHANNEL_MENTION.sub(lambda m: "#" + (m.group(2) or m.group(1)), out)
+    out = _SPECIAL.sub(lambda m: "@" + m.group(1), out)
+    out = _SUBTEAM.sub(lambda m: m.group(1) or "@group", out)
+    out = _LINK.sub(lambda m: f"{m.group(2)} ({m.group(1)})" if m.group(2) else m.group(1), out)
+    return html.unescape(out).strip()
+
+
+def _file_note(f: dict) -> str:
+    # Name and type only. NEVER a url_* field (export links carry a token).
+    name = _clean(f.get("name")) or _clean(f.get("title")) or "file"
+    ftype = _clean(f.get("pretty_type")) or _clean(f.get("filetype")) or _clean(f.get("mimetype"))
+    return f"[file: {name}{' (' + ftype + ')' if ftype else ''}]"
+
+
+def _reaction_note(reactions: Any) -> str:
+    parts = []
+    for r in reactions or []:
+        if not isinstance(r, dict):
+            continue
+        name = _clean(r.get("name"))
+        if not name:
+            continue
+        count = r.get("count")
+        count = count if isinstance(count, int) and count > 0 else len(r.get("users") or []) or 1
+        parts.append(f":{name}: x{count}")
+    return f"[reactions: {', '.join(parts)}]" if parts else ""
+
+
+def normalise_message(
+    raw: dict, users: dict[str, SlackUser], counters: ImportCounters
+) -> NormMessage | None:
+    """One raw Slack message -> ``NormMessage``, or None (counted) when it is
+    not a human message."""
+    counters.messages_seen += 1
+    if not isinstance(raw, dict) or not _clean(raw.get("ts")):
+        counters.malformed += 1
+        return None
+    subtype = raw.get("subtype") or ""
+    if not isinstance(subtype, str):
+        subtype = "<non-string>"
+    if subtype not in _KEPT_SUBTYPES:
+        counters.skipped_subtypes[subtype] += 1
+        return None
+    user_id = _clean(raw.get("user"))
+    if user_id and user_id in users and users[user_id].is_bot:
+        counters.skipped_subtypes["bot_user"] += 1
+        return None
+
+    if subtype == "tombstone":
+        body = "[message deleted]"
+    else:
+        body = render_text(raw.get("text") or "", users)
+    notes = [_file_note(f) for f in raw.get("files") or [] if isinstance(f, dict)]
+    if isinstance(raw.get("edited"), dict):
+        notes.append("(edited)")
+    reaction = _reaction_note(raw.get("reactions"))
+    if reaction:
+        notes.append(reaction)
+    text = " ".join([p for p in [body, *notes] if p]).strip()
+    if not text:
+        counters.skipped_subtypes["empty"] += 1
+        return None
+    thread_ts = _clean(raw.get("thread_ts"))
+    rc = raw.get("reply_count")
+    counters.messages_kept += 1
+    return NormMessage(
+        ts=str(raw["ts"]).strip(),
+        thread_ts=thread_ts,
+        user_id=user_id,
+        text=text,
+        reply_count=rc if isinstance(rc, int) else 0,
+    )
+
+
+# ---------------------------------------------------------------------------
+# Grouping and Conversation building
+# ---------------------------------------------------------------------------
+
+
+def ts_float(ts: str) -> float:
+    try:
+        return float(ts)
+    except (TypeError, ValueError):
+        return 0.0
+
+
+def ts_iso(ts: str, tz: tzinfo = timezone.utc) -> str:
+    """ISO 8601 in the owner's day zone, with its offset. CM048 takes the
+    bundle's folder date from the first 10 characters, so this is what puts a
+    morning in Hong Kong under today's folder and not yesterday's."""
+    return datetime.fromtimestamp(ts_float(ts), tz=tz).isoformat()
+
+
+def local_day(ts: str, tz: tzinfo = timezone.utc) -> str:
+    return ts_iso(ts, tz)[:10]
+
+
+def conversation_id(channel_id: str, unit_kind: str, unit_key: str) -> str:
+    """Deterministic id. ``sk-`` prefix keeps the namespace apart from
+    ``og-`` (ChatGPT), ``cc-`` (Claude Code) and ``ch-`` (channel JSONL)."""
+    payload = f"channel:slack:{channel_id}:{unit_kind}:{unit_key}".encode()
+    return f"sk-{hashlib.sha1(payload).hexdigest()[:16]}"
+
+
+def resolve_privacy_level(raw: str | None) -> str | None:
+    """The owner's explicit level for every Slack conversation, or None.
+
+    Unset -> None: the per-unit default below applies. Any unrecognised
+    value -> L3, so a typo can never publish.
+    """
+    if raw is None or raw == "":
+        return None
+    value = raw.strip().upper()
+    return value if value in _VALID_LEVELS else "L3"
+
+
+def default_unit_level(channel: "ChannelInfo", authors: list[str], self_user_id: str | None) -> str:
+    """Default level for one unit when the owner set none.
+
+    DECISION (red team, 19 Oct: "public channels at L2, decide and justify"):
+    - DMs and group DMs: L2. They are addressed to the owner; they are the
+      owner's own conversations, like iMessage and WhatsApp (L2 there too).
+    - Channels (public AND private): L2 only for a unit the owner WROTE in;
+      a thread or day the owner never posted in is L3.
+    Why: a channel is mostly colleagues talking to each other. Mining their
+    chatter into facts about them (L2 reaches Qdrant/Oxigraph) is storing
+    third parties' words the owner never took part in. L3 still writes the
+    4-artefact bundle, so the owner can browse and search their files; it
+    only keeps it out of facts, the assistant's answers and person pages.
+    "Why was X parked" is answered from threads the owner was in, and the
+    owner can lift everything with OSTLER_SLACK_PRIVACY_LEVEL=L2.
+    """
+    if channel.kind in ("im", "mpim"):
+        return "L2"
+    if self_user_id and self_user_id in authors:
+        return "L2"
+    return "L3"
+
+
+@dataclass
+class BuildContext:
+    users: dict[str, SlackUser]
+    self_user_id: str | None
+    privacy_level: str | None  # explicit owner override, or None
+    route: str  # "export" | "api"
+    workspace: str | None = None
+    day_tz: tzinfo = timezone.utc
+
+
+def _speaker(user_id: str | None, ctx: BuildContext) -> str:
+    if not user_id:
+        return "Unknown"
+    u = ctx.users.get(user_id)
+    return u.display if u else user_id
+
+
+def _participant_rows(user_ids: list[str], ctx: BuildContext) -> tuple[list[str], list[dict]]:
+    ids: list[str] = []
+    rows: list[dict] = []
+    for uid in user_ids:
+        u = ctx.users.get(uid)
+        email = u.email if u else None
+        pid = email or f"slack:{uid}"
+        if pid in ids:
+            continue
+        ids.append(pid)
+        row = {
+            "id": pid,
+            "display": u.display if u else uid,
+            "role": "user" if uid == ctx.self_user_id else "other",
+            "slack_user_id": uid,
+        }
+        # ``handle`` is what CM048 keys the Person URI from. Only a real
+        # email is a key; a bare Slack id would mint a phantom person.
+        if email:
+            row["handle"] = email
+        rows.append(row)
+    return ids, rows
+
+
+def channel_label(channel: ChannelInfo, ctx: BuildContext) -> str:
+    """Human label, derived the same way on both routes (the export names a
+    DM folder by its id, the API by nothing at all)."""
+    if channel.kind in ("im", "mpim"):
+        others = [m for m in channel.members if m != ctx.self_user_id]
+        names = [_speaker(m, ctx) for m in others]
+        if names:
+            prefix = "DM with" if channel.kind == "im" else "Group DM with"
+            return f"{prefix} {', '.join(names)}"
+        return "Direct message"
+    return f"#{channel.name}"
+
+
+def _build(
+    channel: ChannelInfo,
+    unit_kind: str,
+    unit_key: str,
+    msgs: list[NormMessage],
+    ctx: BuildContext,
+) -> Conversation:
+    msgs = sorted(msgs, key=lambda m: ts_float(m.ts))
+    messages = [
+        Message(
+            role="user" if m.user_id and m.user_id == ctx.self_user_id else "participant",
+            content=m.text,
+            timestamp=ts_iso(m.ts, ctx.day_tz),
+            line_index=i,
+            speaker=_speaker(m.user_id, ctx),
+        )
+        for i, m in enumerate(msgs)
+    ]
+    authors = [m.user_id for m in msgs if m.user_id]
+    # DM/MPIM members are participants even if they never spoke in this unit.
+    ordered = list(dict.fromkeys(authors + list(channel.members)))
+    participants, rows = _participant_rows(ordered, ctx)
+    label = channel_label(channel, ctx)
+    if unit_kind == "thread":
+        first = msgs[0].text if msgs else ""
+        name = f"{label} thread: {first[:60]}".rstrip()
+    else:
+        name = f"{label} {unit_key}"
+    cid = conversation_id(channel.channel_id, unit_kind, unit_key)
+    metadata = {
+        "source_app": "slack",
+        "privacy_level": ctx.privacy_level or default_unit_level(channel, authors, ctx.self_user_id),
+        "participant_details": rows,
+        "slack_channel_id": channel.channel_id,
+        "slack_channel_kind": channel.kind,
+        "slack_unit": unit_kind,
+        "slack_unit_key": unit_key,
+        "import_route": ctx.route,
+    }
+    if ctx.workspace:
+        metadata["slack_workspace"] = ctx.workspace
+    return Conversation(
+        conversation_id=cid,
+        provenance=ConversationProvenance(
+            source_kind="channel",
+            source_subtype=SOURCE_SUBTYPE,
+            original_session_id=f"{channel.channel_id}:{unit_kind}:{unit_key}",
+        ),
+        channel="im",
+        participants=participants,
+        messages=messages,
+        last_activity=messages[-1].timestamp if messages else ts_iso("0", ctx.day_tz),
+        created_at=messages[0].timestamp if messages else None,
+        name=name,
+        metadata=metadata,
+    )
+
+
+def build_conversations(
+    channel: ChannelInfo,
+    raw_messages: Iterable[dict],
+    ctx: BuildContext,
+    counters: ImportCounters,
+) -> list[Conversation]:
+    """Group one channel's messages into thread and day conversations."""
+    by_ts: dict[str, NormMessage] = {}
+    for raw in raw_messages:
+        m = normalise_message(raw, ctx.users, counters)
+        if m is None:
+            continue
+        if m.user_id and m.user_id not in ctx.users:
+            counters.unknown_users += 1
+        # A thread_broadcast reply appears both in history and in replies:
+        # one ts is one message.
+        by_ts.setdefault(m.ts, m)
+
+    threads: dict[str, list[NormMessage]] = {}
+    roots_with_replies = {
+        m.thread_ts for m in by_ts.values()
+        if m.thread_ts and m.thread_ts != m.ts
+    }
+    for m in by_ts.values():
+        if m.thread_ts and m.thread_ts != m.ts:
+            threads.setdefault(m.thread_ts, []).append(m)
+        elif m.ts in roots_with_replies or m.reply_count > 0:
+            threads.setdefault(m.ts, []).append(m)
+
+    days: dict[str, list[NormMessage]] = {}
+    for m in by_ts.values():
+        in_thread = (m.thread_ts and m.thread_ts != m.ts) or m.ts in threads
+        if not in_thread:
+            days.setdefault(local_day(m.ts, ctx.day_tz), []).append(m)
+
+    out = [_build(channel, "thread", key, msgs, ctx) for key, msgs in threads.items()]
+    out += [_build(channel, "day", key, msgs, ctx) for key, msgs in days.items()]
+    counters.conversations_built += len(out)
+    return out
+
+
+# Fields that say HOW a conversation was read, not what it says. Excluded from
+# the digest so the export route and the API route agree that the same
+# conversation is unchanged (no re-post when the owner switches route).
+_ROUTE_ONLY_FIELDS = ("import_route", "slack_workspace")
+
+
+def digest(conv: Conversation) -> str:
+    """Content digest for idempotent re-import: an unchanged conversation is
+    not posted again; an edit, a new reply, a new reaction or a privacy
+    change alters it."""
+    data = conv.to_dict()
+    data["metadata"] = {
+        k: v for k, v in data["metadata"].items() if k not in _ROUTE_ONLY_FIELDS
+    }
+    blob = json.dumps(data, sort_keys=True, ensure_ascii=False)
+    return hashlib.sha256(blob.encode("utf-8")).hexdigest()

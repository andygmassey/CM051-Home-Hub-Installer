-    current_status: str,
-    *,
-    ever_applied: bool,
-) -> TransitionPlan:
-    """Decide what ``action`` does to a correction in ``current_status``.
-
-    Pure. No network, no clock, no UUIDs -- every branch of the table in the
-    block comment above is reachable from a unit test with three arguments.
-
-    ``ever_applied`` must be derived from the audit trail (see
-    :func:`read_correction_state`), not guessed from ``current_status``:
-    ``rejected`` is reachable both from a rejected proposal and from a reverted
-    application, and ``revert`` is legal for exactly one of those.
-    """
-    def _no_op() -> TransitionPlan:
-        return TransitionPlan(action, current_status, current_status, False)
-
-    def _refuse(why: str) -> TransitionPlan:
-        return TransitionPlan(action, current_status, current_status, False, why)
-
-    if action not in ALLOWED_ACTIONS:
-        return _refuse(
-            f"action must be one of {sorted(ALLOWED_ACTIONS)} (got {action!r})"
-        )
-
-    if action == ACTION_APPROVE:
-        if current_status == STATUS_APPLIED:
-            return _no_op()
-        if current_status == STATUS_PENDING:
-            return TransitionPlan(action, current_status, STATUS_APPLIED, True)
-        return _refuse(
-            "cannot approve a correction in status "
-            f"{current_status!r}: a rejected correction is re-proposed by "
-            "filing it again, not approved in place"
-        )
-
-    if action == ACTION_REJECT:
-        if current_status == STATUS_REJECTED:
-            return _no_op()
-        if current_status == STATUS_PENDING:
-            return TransitionPlan(action, current_status, STATUS_REJECTED, True)
-        return _refuse(
-            "cannot reject a correction that is already applied: use "
-            f"{ACTION_REVERT!r}, which records that it took effect and was "
-            "taken back"
-        )
-
-    # ACTION_REVERT
-    if current_status == STATUS_APPLIED:
-        return TransitionPlan(action, current_status, STATUS_REJECTED, True)
-    if current_status == STATUS_REJECTED and ever_applied:
-        return _no_op()
-    return _refuse(
-        f"cannot revert a correction in status {current_status!r} that was "
-        "never applied: there is nothing to take back"
-    )
-

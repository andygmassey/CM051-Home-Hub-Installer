+    until_val = "" if until is None else str(int(until))
+    tail = (
+        f"export {KEY_PAUSED}={'1' if paused else '0'}\n"
+        f"export {KEY_PAUSE_UNTIL}={until_val}\n"
+    )
+    return body + "\n" + tail

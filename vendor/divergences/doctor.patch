-def transition_correction(
-    payload: Dict[str, Any],
-    *,
-    oxigraph_url: Optional[str] = None,
-    http_client: Optional[httpx.Client] = None,
-    now: Optional[datetime] = None,
-) -> Dict[str, Any]:
-    """Read, decide, write, then read back. Returns the handler's response.
-
-    Raises :class:`ValidationError` with 404 for an unknown correction and 409
-    for a refused move, so the HTTP handler maps both the same way it maps the
-    validation failures.
-
-    The final read-back is not belt-and-braces. The UPDATE is guarded on the
-    status we read, so "the request succeeded" and "the status moved" are
-    genuinely different outcomes, and only a read can tell them apart.
-    """
-    base = (oxigraph_url or _oxigraph_url()).rstrip("/")
-    correction_uri = payload["correction_uri"]
-
-    state = read_correction_state(
-        correction_uri, oxigraph_url=base, http_client=http_client,
-    )
-    if state is None:
-        raise ValidationError(404, f"no such correction: {correction_uri}")
-
-    plan = plan_transition(
-        payload["action"], state["status"], ever_applied=state["ever_applied"],
-    )
-    if not plan.ok:
-        raise ValidationError(409, plan.refusal)
-
-    if not plan.changed:
-        # Idempotent no-op. Nothing is written, not even an audit row: a retry
-        # after a dropped connection has to be free, and a trail that grows a
-        # record every time someone re-clicks a settled decision buries the
-        # decisions that did something.
-        return {
-            "correction_uri": correction_uri,
-            "action": plan.action,
-            "status": state["status"],
-            "previous_status": state["status"],
-            "changed": False,
-            "transition_uri": None,
-            "history": state["history"],
-        }
-
-    transition_uri, sparql = build_transition_update(
-        correction_uri=correction_uri,
-        plan=plan,
-        actor=payload["actor"],
-        reason=payload.get("reason", ""),
-        now=now,
-    )
-    _sparql_update(base, sparql, http_client=http_client)
-
-    after = read_correction_state(
-        correction_uri, oxigraph_url=base, http_client=http_client,
-    )
-    if after is None or after["status"] != plan.to_status:
-        observed = None if after is None else after["status"]
-        raise ValidationError(
-            409,
-            f"transition did not take effect: expected {plan.to_status!r}, "
-            f"store reports {observed!r}. The correction was most likely moved "
-            "by another writer between the read and the write.",
-        )
-
-    return {
-        "correction_uri": correction_uri,
-        "action": plan.action,
-        "status": after["status"],
-        "previous_status": plan.from_status,
-        "changed": True,
-        "transition_uri": transition_uri,
-        "history": after["history"],
-    }

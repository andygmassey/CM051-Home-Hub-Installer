+def _iso_age_s(stamp: str):
+    from datetime import datetime, timezone
+    try:
+        t = datetime.strptime(stamp, "%Y-%m-%dT%H:%M:%SZ").replace(
+            tzinfo=timezone.utc
+        )
+    except (TypeError, ValueError):
+        return None
+    return time.time() - t.timestamp()
+

-def validate_transition_payload(body: Any) -> Dict[str, Any]:
-    """Validate the JSON body of a transition request.
-
-    Deliberately mirrors :func:`validate_payload`'s error codes so the two
-    endpoints behave the same way under a client that handles one of them:
-    415 for a missing required field, 400 for a bad type or value.
-    """
-    if not isinstance(body, dict):
-        raise ValidationError(400, "body must be a JSON object")
-
-    for field in ("correction_uri", "action", "actor"):
-        if field not in body:
-            raise ValidationError(415, f"missing required field: {field}")
-
-    for field in ("correction_uri", "action", "actor", "reason"):
-        if field in body and not isinstance(body[field], str):
-            raise ValidationError(400, f"field {field!r} must be a string")
-
-    correction_uri = body["correction_uri"].strip()
-    if not correction_uri or " " in correction_uri:
-        raise ValidationError(400, "correction_uri must be a non-empty URI")
-    if ">" in correction_uri or "<" in correction_uri:
-        # These would terminate the IRI in the SPARQL we build. Angle brackets
-        # are not legal in an IRI anyway, so this rejects nothing valid.
-        raise ValidationError(400, "correction_uri must not contain angle brackets")
-
-    action = body["action"]
-    if action not in ALLOWED_ACTIONS:
-        raise ValidationError(
-            400,
-            f"action must be one of {sorted(ALLOWED_ACTIONS)} (got {action!r})",
-        )
-
-    actor = body["actor"]
-    if actor not in ALLOWED_ACTORS:
-        raise ValidationError(
-            400,
-            f"actor must be one of {sorted(ALLOWED_ACTORS)} (got {actor!r})",
-        )
-    if action == ACTION_APPROVE and actor in ACTORS_FORBIDDEN_FROM_APPROVING:
-        raise ValidationError(
-            403,
-            f"actor {actor!r} may not approve a correction: assistant-proposed "
-            "corrections are held for human review, and self-approval would "
-            "make that hold meaningless",
-        )
-
-    return {
-        "correction_uri": correction_uri,
-        "action": action,
-        "actor": actor,
-        "reason": body.get("reason", ""),
-    }
-

-def read_correction_state(
-    correction_uri: str,
-    *,
-    oxigraph_url: Optional[str] = None,
-    http_client: Optional[httpx.Client] = None,
-) -> Optional[Dict[str, Any]]:
-    """Current status plus the full transition history, or None if absent.
-
-    Returns ``None`` when the URI names no ``pwg:Correction`` -- the caller
-    turns that into a 404. An empty result and a correction with no status are
-    the same thing here on purpose: the loader in CM044 requires
-    ``pwg:correctionStatus`` in its basic graph pattern too, so a correction
-    without one is invisible to the compiler and may as well not exist.
-
-    ``ever_applied`` is the reason the history is read at all. It is true if
-    the correction is applied now, or if any transition in its chain entered or
-    left ``applied``.
-    """
-    base = (oxigraph_url or _oxigraph_url()).rstrip("/")
-    sparql = (
-        f"PREFIX pwg: <{PWG_PREFIX_URL}>\n"
-        "SELECT ?status ?action ?from ?to ?at ?actor ?reason WHERE {\n"
-        f"  <{correction_uri}> a pwg:Correction ;\n"
-        "                     pwg:correctionStatus ?status .\n"
-        "  OPTIONAL {\n"
-        f"    <{correction_uri}> pwg:correctionTransition ?t .\n"
-        "    ?t pwg:transitionAction ?action ;\n"
-        "       pwg:transitionFrom ?from ;\n"
-        "       pwg:transitionTo ?to ;\n"
-        "       pwg:transitionAt ?at ;\n"
-        "       pwg:transitionActor ?actor .\n"
-        "    OPTIONAL { ?t pwg:transitionReason ?reason }\n"
-        "  }\n"
-        "} ORDER BY ?at"
-    )
-
-    rows = _sparql_select(base, sparql, http_client=http_client)
-    if not rows:
-        return None
-
-    status = rows[0]["status"]
-    history = [
-        {
-            "action": r["action"],
-            "from_status": r["from"],
-            "to_status": r["to"],
-            "at": r["at"],
-            "actor": r["actor"],
-            "reason": r.get("reason", ""),
-        }
-        for r in rows
-        if "action" in r
-    ]
-    ever_applied = status == STATUS_APPLIED or any(
-        h["from_status"] == STATUS_APPLIED or h["to_status"] == STATUS_APPLIED
-        for h in history
-    )
-    return {
-        "correction_uri": correction_uri,
-        "status": status,
-        "history": history,
-        "ever_applied": ever_applied,
-    }
-

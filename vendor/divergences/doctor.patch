+    until_raw = values.get(KEY_PAUSE_UNTIL, "").strip()
+    # Empty or "forever" -> paused until an explicit resume.
+    if until_raw in ("", "forever"):
+        return {
+            "paused": True,
+            "expiry": None,
+            "indefinite": True,
+            "expiry_human": "",
+            "scope": SCOPE_INDEFINITE,
+            "governor_env_path": str(p),
+        }

-def build_transition_update(
-    *,
-    correction_uri: str,
-    plan: TransitionPlan,
-    actor: str,
-    reason: str = "",
-    transition_uri: Optional[str] = None,
-    now: Optional[datetime] = None,
-) -> Tuple[str, str]:
-    """Build the guarded DELETE+INSERT for one status transition.
-
-    Returns ``(transition_uri, sparql)``.
-
-    The ``WHERE`` clause re-asserts the status the plan was made against. If
-    another writer moved the correction between the read and this write, the
-    pattern matches nothing, NOTHING is written, and the caller's read-back
-    sees the status it did not ask for and says so. Without that FILTER a
-    concurrent approve and revert would both "succeed" and the loser would
-    overwrite the winner with no trace.
-    """
-    when = (now or datetime.now(timezone.utc)).isoformat()
-    if transition_uri is None:
-        transition_uri = f"{PWG_PREFIX_URL}transition_{uuid.uuid4().hex}"
-
-    audit = [
-        f"<{transition_uri}> a pwg:CorrectionTransition",
-        f'<{transition_uri}> pwg:transitionAction "{_sparql_string(plan.action)}"',
-        f'<{transition_uri}> pwg:transitionFrom "{_sparql_string(plan.from_status)}"',
-        f'<{transition_uri}> pwg:transitionTo "{_sparql_string(plan.to_status)}"',
-        f'<{transition_uri}> pwg:transitionAt "{when}"^^xsd:dateTime',
-        f'<{transition_uri}> pwg:transitionActor "{_sparql_string(actor)}"',
-    ]
-    if reason:
-        audit.append(
-            f'<{transition_uri}> pwg:transitionReason "{_sparql_string(reason)}"'
-        )
-    audit_body = " .\n    ".join(audit) + " ."
-
-    sparql = (
-        f"PREFIX pwg: <{PWG_PREFIX_URL}>\n"
-        "PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>\n"
-        "DELETE {\n"
-        f"  <{correction_uri}> pwg:correctionStatus ?old .\n"
-        "}\n"
-        "INSERT {\n"
-        f'  <{correction_uri}> pwg:correctionStatus "{_sparql_string(plan.to_status)}" .\n'
-        f"  <{correction_uri}> pwg:correctionTransition <{transition_uri}> .\n"
-        f"    {audit_body}\n"
-        "}\n"
-        "WHERE {\n"
-        f"  <{correction_uri}> a pwg:Correction ;\n"
-        "                     pwg:correctionStatus ?old .\n"
-        f'  FILTER(STR(?old) = "{_sparql_string(plan.from_status)}")\n'
-        "}\n"
-    )
-    return transition_uri, sparql
-
-
-def _sparql_update(
-    base: str,
-    sparql: str,
-    *,
-    http_client: Optional[httpx.Client] = None,
-) -> None:
-    own_client = http_client is None
-    client = http_client or httpx.Client(timeout=30.0)
-    try:
-        resp = client.post(
-            f"{base}/update",
-            content=sparql,
-            headers={"Content-Type": "application/sparql-update"},
-        )
-        resp.raise_for_status()
-    finally:
-        if own_client:
-            client.close()

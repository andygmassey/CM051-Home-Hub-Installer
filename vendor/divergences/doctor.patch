+    "written": "#2C4A2C",
+    "empty": "rgba(236,232,225,0.55)",
+    "not_run": "#5C4611",
+    "not_scheduled": "#7A1F1F",
+    "not_written": "#5C4611",
+    "cannot_start": "#7A1F1F",
+    "deferred": "#5C4611",
+    "yielded": "#5C4611",
+    "in_progress": "#5C4611",
+    "stale": "#5C4611",

-def _sparql_select(
-    base: str,
-    sparql: str,
-    *,
-    http_client: Optional[httpx.Client] = None,
-) -> list:
-    """Run a SELECT and return a list of ``{var: value}`` dicts.
-
-    Unbound OPTIONAL variables are simply absent from a row rather than
-    present-and-None, which is what the callers below test with ``.get``.
-    """
-    own_client = http_client is None
-    client = http_client or httpx.Client(timeout=30.0)
-    try:
-        resp = client.post(
-            f"{base}/query",
-            content=sparql,
-            headers={
-                "Content-Type": "application/sparql-query",
-                "Accept": "application/sparql-results+json",
-            },
-        )
-        resp.raise_for_status()
-        payload = resp.json()
-    finally:
-        if own_client:
-            client.close()
-
-    rows = []
-    for binding in payload.get("results", {}).get("bindings", []):
-        rows.append({k: v.get("value", "") for k, v in binding.items()})
-    return rows
-

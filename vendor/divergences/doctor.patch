+    findings.append({
+        "severity": "warning",
+        "title": IMESSAGE_CAPTURE_STALLED_TITLE,
+        "detail": IMESSAGE_CAPTURE_STALLED_DETAIL,
+        "fix": IMESSAGE_CAPTURE_STALLED_FIX,
+        "fix_command": IMESSAGE_CAPTURE_STALLED_FIX_COMMAND,
+        "risk": "low",
+        "category": "installation",
+    })
+    return findings

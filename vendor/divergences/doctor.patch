+        "paused": True,
+        "expiry": until,
+        "indefinite": False,
+        "expiry_human": _human(until),
+        "scope": SCOPE_HOUR if (until - time.time()) <= 3600 + 1 else SCOPE_TONIGHT,
+        "governor_env_path": str(p),

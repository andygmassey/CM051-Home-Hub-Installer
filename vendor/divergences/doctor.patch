+                    capture=capture,
+                ),
+                "fix": LISTENER_RECOVERED_FIX,
+                "fix_command": LISTENER_RECOVERED_FIX_COMMAND,
+                "risk": "low",
+                "category": "runtime",
+            })
+    return findings

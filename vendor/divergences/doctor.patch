+    tile = f"""
+        <div class="status-card">
+            <div class="status-indicator" style="background:{colour}">{icon}</div>
+            <div class="status-info">
+                <div class="status-name">{_html_escape(status_label)}</div>
+                <div class="status-detail">{_html_escape(detail)}</div>
+                {extra_lines}
+                {how_to_fix}
+            </div>
+        </div>"""
+
+    return f"""

+        "schema": REPLY_DEBT_SNAPSHOT_SCHEMA,
+        "status": "ok",
+        "generated_at": datetime.now(timezone.utc).isoformat(),
+        "producer": "imessage_source (ostler-assistant run-source imessage)",
+        "lookback_days": lookback_days,
+        "threads": threads,

+_MAX_TITLE_TEXT = 60
+_EMAIL_RE = re.compile(r"\S+@\S+")
+_AT_HANDLE_RE = re.compile(r"(?<!\w)@\w[\w.]*")
+_PHONE_RE = re.compile(r"\+?\d[\d\s().-]{4,}\d")
+_ISO_RE = re.compile(r"\b20\d\d-\d\d-\d\d(?:[T ][\d:.]+Z?)?\b")

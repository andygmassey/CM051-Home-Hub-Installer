+def _handle_variants(handle: str) -> list[str]:
+    h = handle.strip()
+    out = [h, h.lower()]
+    digits = "".join(c for c in h if c.isdigit())
+    if digits and "@" not in h:
+        out += [digits, "+" + digits]
+    seen: list[str] = []
+    for v in out:
+        if v and v not in seen:
+            seen.append(v)
+    return seen

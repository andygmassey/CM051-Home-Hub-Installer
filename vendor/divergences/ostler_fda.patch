+        for p in named:
+            for key in names[p]:
+                groups.setdefault(key, set()).add(p)
+        for key, members in sorted(groups.items()):
+            if len(members) > 1:
+                out[("phone", f"{value}#name={key}")] = sorted(members)
+    return out, refused
 
 

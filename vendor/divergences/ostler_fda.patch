+    """``2026-09-10 12:34:56.5+08:00`` (str(datetime)) -> xsd:dateTime form."""
+    raw = raw.strip()
+    if len(raw) > 10 and raw[10] == " ":
+        raw = raw[:10] + "T" + raw[11:]
+    return raw

+            gone.append(f'<{uri}> <{NS}alternateName> "{_escape(d)}" .')
+        if clear:
+            gone.append(f"<{uri}> <{NS}displayNameProvisional> ?f .")
+        where = (
+            f"  OPTIONAL {{ <{uri}> <{NS}displayNameProvisional> ?f }}\n"
+            if clear else "  BIND(1 AS ?ignore)\n"
+        )

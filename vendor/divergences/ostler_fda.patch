+        return _NAME_TIER_HANDLE
+    digits = sum(c.isdigit() for c in v)
+    phoneish = all(c in "+()-. \t0123456789" for c in v)
+    if phoneish and digits >= 5:
+        return _NAME_TIER_PLACEHOLDER

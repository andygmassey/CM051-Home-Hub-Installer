+    sdir = state_dir(ostler_dir)
+    sdir.mkdir(parents=True, exist_ok=True)
+    tmp = sdir / (STATE_NAME + ".tmp")
+    tmp.write_text(json.dumps(state))
+    os.replace(tmp, sdir / STATE_NAME)

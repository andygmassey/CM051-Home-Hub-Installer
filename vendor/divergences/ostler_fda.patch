+            "Refused %r as a displayName for %s at creation: it is a "
+            "relationship, not a name (v1018-D659)", value, person_uri,
+        )
+        return [flag]
+    triples = [f'<{person_uri}> pwg:displayName "{_escape(value)}"']
+    if tier < _NAME_TIER_NAME:
+        triples.append(flag)
+    return triples
+

+        sparql_people = (
+            f"SELECT ?person ?name ?org WHERE {{ "
+            f"  ?person a <{PWG}Person> ; "
+            f"          <{PWG}displayName> ?name . "
+            f"  OPTIONAL {{ ?person <{PWG}organization> ?org }} "

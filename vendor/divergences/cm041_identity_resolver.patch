-    A candidate is a node whose stored displayName is EXACTLY the compound this
-    codebase assembles from a kinship given name plus the family name.
-    """
-    display = " ".join((display or "").split())
-    givens = [g for g in (x.strip() for x in givens) if g]
-    families = [f for f in (x.strip() for x in families) if f]
-    if not display:
-        return False, None, "no displayName"
-
-    kin = [g for g in givens if is_kinship_given_name(g)]
-    if not kin:
-        return False, None, "no kinship givenName on the node"
-
-    welded = {
-        w.casefold()
-        for g in kin
-        for f in (families or [None])
-        for w in ([_full_name(g, f)] if _full_name(g, f) else [])
-    }
-    if display.casefold() not in welded:
-        return False, None, "displayName is not the manufactured compound"
-
-    # It IS the compound. Is there anything better to put there?
-    better = choose_canonical_display_name(
-        [],
-        given_name=prefer_real_given_name(givens),
-        family_name=families[0] if families else None,
-    )
-    if not better:
-        return True, None, "compound, but no better name available -- LEFT ALONE"
-    if better.casefold() == display.casefold():
-        return True, None, "compound, and the repair would not change it -- LEFT ALONE"

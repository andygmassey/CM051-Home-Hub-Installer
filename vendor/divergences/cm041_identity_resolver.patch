+            f"SELECT ?person ?linkedinUrl WHERE {{ "
+            f"  ?person <{PWG}hasIdentifier> ?lid . "
+            f'  ?lid <{PWG}identifierType> "linkedin_url" ; '
+            f"       <{PWG}identifierValue> ?linkedinUrl . "
+            f"}}"
+        )

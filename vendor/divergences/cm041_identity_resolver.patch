-    # TWO KINDS OF REPAIR, AND AN OPERATOR SHOULD NOT BE ASKED TO APPROVE THEM
-    # AS ONE. Promoting to a real full name recovers information the node
-    # already holds. Promoting to the family name ALONE discards the given name
-    # and leaves a mononym -- which is #142's deliberate "incomplete beats
-    # wrong" trade, correct for a name being CONSTRUCTED, but a visible
-    # downgrade when applied to a record a person already reads. Gated behind
-    # --include-mononym so it is chosen, not absorbed.
-    if not [f for f in families if better.casefold() == f.casefold()]:
-        return True, better, "compound, repairable to a full name"
-    return True, better, "compound, repairable only to the family name (mononym)"

+    start = depth = None
+    while i < n:
+        c = sparql[i]
+        if c == "#" and depth is None:
+            j = sparql.find("\n", i)
+            i = n if j < 0 else j + 1
+            continue
+        if c in "'\"":
+            quote_tok = sparql[i:i + 3] if sparql[i:i + 3] in ("'''", '"""') else c

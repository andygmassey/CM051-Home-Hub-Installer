+        rows = _sparql_select(
+            'PREFIX pwg: <{ns}>\n'
+            'SELECT ?p ?name ?bday WHERE {{\n'
+            '  ?p a pwg:Person ; pwg:displayName ?name ; pwg:birthday ?bday .\n'
+            '}}'.format(ns=PWG_NS)
+        )
+        suppressed_slugs, suppressed_uris = _suppressed_identity_index()

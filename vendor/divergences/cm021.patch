+# Escaping artefacts a mail parser can leak into a display name when the From
+# header was quoted badly: a leading/trailing run of tildes, straight or smart
+# quotes, and backslashes. A clean human display name never carries these, so
+# both their PRESENCE (a refusal signal) and their removal (for a clean write)
+# are handled here. Andy's #30 console walk: a People node named
+# ``~~\"Unusual sign-in on your iCloud.`` -- an Apple security-notification
+# SUBJECT, with ``~~`` and a backslash-quote leaked into the display name --
+# defeated the sentence-opener arm below because the junk sat before the first
+# word, and nothing refused the junk itself.
+_LEADING_NAME_JUNK_RE = re.compile(r'^[~"\'\\“”‘’\s]+')
+_TRAILING_NAME_JUNK_RE = re.compile(r'[~"\'\\“”‘’\s]+$')
 
+
+def clean_display_name(name: Optional[str]) -> str:
+    """Strip escaping artefacts from a display name: backslash-escaped quotes
+    anywhere, and a leading/trailing run of tildes, quotes (straight or smart),
+    backslashes and whitespace. Idempotent. Used to write a clean displayName
+    AND to evaluate name-validity on the cleaned text."""
+    s = name or ""
+    s = s.replace('\\"', "").replace("\\'", "")
+    s = _LEADING_NAME_JUNK_RE.sub("", s)
+    s = _TRAILING_NAME_JUNK_RE.sub("", s)
+    return s.strip()
+
+
+def _has_escaping_artefact(name: str) -> bool:
+    """True when ``name`` carries a quoting/escaping artefact a clean human
+    name never does: it opens with a tilde/quote/backslash, or contains ``~~``
+    or a backslash-escaped quote."""
+    s = (name or "").strip()
+    if not s:
+        return False
+    if s[0] in "~\"'\\“”‘’":
+        return True
+    return "~~" in s or '\\"' in s or "\\'" in s
+
+
+def _is_gibberish_name(name: str) -> bool:
+    """True when a name carries a token that is a letter+digit MASH inside one
+    word (``Qzr5531tb``, ``07alex``, ``Pvo2217sd``, ``Kjv3``, ``Wq7b``) --
+    an extraction artefact, never a human-name token. Anchored on Andy's #30
+    walk-shaped examples ("07alex Qzr5531tb", "58mxtb Pvo2217sd", ...). The length>=4
+    floor keeps real alphanumerics that are not names off the hook of a false
+    positive the other way ("O2", "3M", "B2B" are short and not person names
+    anyway); a human name token never interleaves letters and digits."""
+    for token in (name or "").split():
+        core = re.sub(r"[^A-Za-z0-9]", "", token)
+        if len(core) >= 4 and any(c.isalpha() for c in core) and any(c.isdigit() for c in core):
+            return True
+    return False
+

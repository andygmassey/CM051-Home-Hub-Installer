#!/usr/bin/env bash
# githooks-pre-commit-operator-pii
#
# Pre-commit hook that runs operator-pii-scan against the STAGED diff
# only (not the whole working tree). Drops staged file contents into
# a temp dir, scans that, exits non-zero on any hit.
#
# Installation: this file is dropped at .githooks/pre-commit-operator-pii
# by bin/install-pii-guards.sh. The installer also wires
# .githooks/pre-commit to invoke this script and configures
# core.hooksPath = .githooks.
#
# The scanner is resolved via OPERATOR_PII_SCAN_BIN with a documented
# default. Override only if your HR015 checkout lives somewhere
# non-standard.
#
# Exit codes:
#   0 - clean (no PII in staged content)
#   1 - PII found OR scanner unavailable (commit blocked)
#
# Do NOT add a --no-verify / skip-if-env-var escape hatch here.
# If the hook is wrong, fix the cause. Per repo policy.

set -u

# The shape scanner lives IN this repo, unlike the identity scanner above.
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || echo .)"

SCANNER="${OPERATOR_PII_SCAN_BIN:-$HOME/Documents/Projects/HR015 - Gaming PC/bin/operator-pii-scan.sh}"

if [ ! -x "$SCANNER" ]; then
    echo "operator-pii-scan hook: scanner not executable at:" >&2
    echo "  $SCANNER" >&2
    echo "" >&2
    echo "Set OPERATOR_PII_SCAN_BIN to the path of bin/operator-pii-scan.sh" >&2
    echo "in your HR015 - Gaming PC checkout, or install HR015 at the default" >&2
    echo "location (\$HOME/Documents/Projects/HR015 - Gaming PC)." >&2
    exit 1
fi

# Collect staged files (added/copied/modified/renamed; skip deletes).
STAGED_FILES="$(git diff --cached --name-only --diff-filter=ACMR)"

if [ -z "$STAGED_FILES" ]; then
    echo "operator-pii-scan: clean (0 files scanned)"
    exit 0
fi

# Build a temp dir mirroring the staged content so the scanner can
# walk it like a normal target path.
STAGE_DIR="$(mktemp -d -t operator-pii-XXXXXX)"
trap 'rm -rf "$STAGE_DIR"' EXIT

# ⚠️ ASK THE QUESTION CI ASKS, NOT A STRICTER ONE (#1610).
#
# This loop used to stage every file's WHOLE staged blob, so a modified file
# was scanned in full. CI does not do that: it sets BASE_REF and narrows
# MODIFIED files to their ADDED LINES, keeping whole-file scanning for
# added/renamed/copied (where all the content is new at that path, so a
# rename cannot smuggle a file of PII to a new location).
#
# MEASURED 2026-09-05: origin/main's own install.sh, unmodified, fails the
# whole-file scan on /Users/ and /home/ shapes that have been on main for
# months. So this hook was red for EVERY commit touching install.sh, and the
# only way past it is --no-verify, which also disables check-rule-09-strings
# and the assistant-name check. A gate you can only satisfy by switching off
# the other gates teaches the habit of switching off the other gates.
#
# That is the same defect the scanner's own header records from #587 and says
# it removed for PRs -- it just never reached this path, because the hook
# hands the scanner PATH ARGUMENTS and that takes the whole-file branch.
#
# The sed below is copied from the scanner's BASE_REF branch deliberately,
# character for character, so the two instruments cannot drift into
# disagreeing about what "an added line" means.
COUNT=0
while IFS= read -r path; do
    [ -z "$path" ] && continue
    dest="$STAGE_DIR/$path"
    mkdir -p "$(dirname "$dest")"
    # git show ":path" prints the staged blob (handles new + modified).
    if git show ":$path" > "$dest" 2>/dev/null; then
        COUNT=$((COUNT + 1))
    else
        # Submodule / symlink / etc that git show can't materialise.
        rm -f "$dest"
        continue
    fi
    # For a MODIFIED file, replace that whole blob with just its added lines.
    # Added / copied / renamed keep the full blob written above.
    if git diff --cached --name-only --diff-filter=M -- "$path" | grep -qx -- "$path"; then
        added="$(git diff --cached -U0 -- "$path" \
                 | sed -n 's/^+\([^+].*\)$/\1/p; s/^+$//p')"
        if [ -n "$added" ]; then
            printf '%s\n' "$added" > "$dest"
        else
            # Nothing added: a pure deletion or mode change. There is nothing
            # new to accuse, and scanning the old content would accuse the
            # tree rather than the commit.
            rm -f "$dest"
            COUNT=$((COUNT - 1))
        fi
    fi
done <<< "$STAGED_FILES"

if [ "$COUNT" -eq 0 ]; then
    echo "operator-pii-scan: clean (0 scannable files staged)"
    exit 0
fi

# Run the scanner. Capture output so we can rewrite the temp-dir prefix.
OUTPUT="$("$SCANNER" "$STAGE_DIR" 2>&1)"
STATUS=$?

# ── THE SECOND SCANNER, AND WHY BOTH ARE NEEDED (#1556) ──────────────────
#
# MEASURED on CM051 #1554, 2026-09-05. This hook printed
#
#     operator-pii-scan: clean (5 files scanned)
#
# and CI then red on THOSE SAME FIVE FILES:
#
#     ci-pii-shape-scan: PII-shaped content in 5 examined file(s):
#       pattern '/Users/[a-z0-9._-]+/?' matched in: ... 3 files
#
# Same tree, same five files, opposite verdicts. They are two different
# scanners in two different repositories and only the nickname is shared:
#
#   this hook   $HOME/Documents/Projects/HR015 - Gaming PC/bin/operator-pii-scan.sh
#               an absolute path OUT of this repo, hunting operator IDENTITY
#   CI          .github/scripts/ci-pii-shape-scan.sh
#               in this repo, 9 SHAPE patterns including the home-path one
#
# Different questions, both legitimate, and the hook asked only the first
# while branch protection asked only the second. So "clean (5 files scanned)"
# carried NO information about whether `scan` would pass -- and it names a
# denominator, which makes it read as a complete answer. A hook that said
# nothing would have been less dangerous.
#
# The shape scanner takes FILE arguments and this hook already has the exact
# list materialised in $STAGE_DIR, so it costs one call.
#
# ⚠️ IT MUST NOT BE ALLOWED TO GO QUIET. Two scanners means two ways to report
# a hollow pass. The shape scanner already models the right behaviour: handed
# a directory it exits 2 with "This scanner reads FILES ... reporting the
# resulting zero as a pass would be a clean bill from a scan that examined
# nothing." Anything other than 0 or 1 from it is treated here as CANNOT-RUN
# and BLOCKS, rather than being read as an absence of findings.
_run_shape_scan() {
    local shape="${REPO_ROOT:-.}/.github/scripts/ci-pii-shape-scan.sh"
    [ -x "$shape" ] || {
        echo "operator-pii-scan: CANNOT-RUN -- the shape scanner is missing at" >&2
        echo "  $shape" >&2
        echo "  That is not a clean bill. The identity scan alone does not cover" >&2
        echo "  the shape patterns CI enforces (#1556)." >&2
        return 2
    }
    local files=()
    while IFS= read -r -d '' f; do files+=("$f"); done         < <(find "$STAGE_DIR" -type f -print0 2>/dev/null)
    [ "${#files[@]}" -gt 0 ] || {
        echo "operator-pii-scan: CANNOT-RUN -- nothing was staged for the shape scan." >&2
        return 2
    }
    "$shape" "${files[@]}"
}

case "$STATUS" in
    0)
        _shape_out="$(_run_shape_scan 2>&1)"; _shape_rc=$?
        case "$_shape_rc" in
            0) echo "operator-pii-scan: clean ($COUNT files scanned, identity + shape)" ;;
            1) echo "operator-pii-scan: BLOCKED -- PII-SHAPED content in staged files" >&2
               echo "" >&2
               printf '%s
' "$_shape_out" | sed "s|$STAGE_DIR/||g" >&2
               echo "" >&2
               echo "This is the check CI runs as \`scan\`. Fixing it here saves a round trip." >&2
               exit 1 ;;
            *) echo "operator-pii-scan: BLOCKED -- the shape scan could not run (rc=$_shape_rc)" >&2
               printf '%s
' "$_shape_out" >&2
               echo "" >&2
               echo "CANNOT-RUN is not a pass. Resolve the cause rather than committing past it." >&2
               exit 1 ;;
        esac
        exit 0
        ;;
    1)
        echo "operator-pii-scan: BLOCKED -- operator PII detected in staged content" >&2
        echo "" >&2
        # Strip the temp-dir prefix so paths read as repo-relative.
        printf '%s\n' "$OUTPUT" | sed "s|$STAGE_DIR/||g" >&2
        echo "" >&2
        echo "Fix the offending content and re-stage. Do not bypass with --no-verify." >&2
        exit 1
        ;;
    *)
        echo "operator-pii-scan: scanner returned error status $STATUS" >&2
        printf '%s\n' "$OUTPUT" >&2
        exit 1
        ;;
esac

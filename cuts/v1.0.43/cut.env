# cuts/v1.0.43/cut.env -- the pins this cut is made from.
#
# CM051 names the tree whose install.sh SHIPS, compared by BLOB IDENTITY and
# not by ancestry: v1.0.31 pinned a commit that WAS an ancestor of main and
# whose install.sh predated the three fixes v1.0.31 existed to carry.
#
# 44aab3ca is main at the moment this cut record was written. The PR that adds
# this file touches Info.plist, cut.yml and cut-manifests/ -- NOT install.sh --
# so the blob it names is the blob that ships.
CUT_VERSION=1.0.43
DAEMON_COMMIT=1b0a5013525a
CM051=44aab3ca25d155a7c8f49f2632e4331d2a5c6ffa

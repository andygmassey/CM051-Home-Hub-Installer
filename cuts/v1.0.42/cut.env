# cuts/v1.0.42/cut.env
#
# THE PINS THIS CUT WAS MADE FROM. Read by scripts/verify_cut_pin_is_current.sh,
# which compares the CM051 pin's install.sh BLOB against the tree being cut --
# not the commit sha. A re-point commit that touches only this file therefore
# still agrees, which is why adding cut.env after the tag is safe and why the
# gate was written that way (see its own comment at ~line 286).
#
# v1.0.31 is the reason this gate exists: its cut.env still pinned CM051=f219eb0
# whose install.sh predated the fix the cut claimed to carry.
CUT_VERSION=1.0.42
DAEMON_COMMIT=1b0a5013525a
CM051=843b425608b301403ed2da5b0f26beef07c56237

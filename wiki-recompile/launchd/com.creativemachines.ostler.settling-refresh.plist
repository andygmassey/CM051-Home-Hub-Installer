<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
        Ostler settling refresh LaunchAgent. Every 15 minutes (900 s) runs
        the CM044 settling-only compile so settling.json, which feeds the
        setup status screen, is never more than about 15 minutes old between
        the daily full compiles. Placeholders as for the wiki-recompile
        agent: OSTLER_BIN, OSTLER_HOME, OSTLER_LOGS.
    -->
    <key>Label</key>
    <string>com.creativemachines.ostler.settling-refresh</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>OSTLER_BIN/settling-refresh-tick.sh</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>StartInterval</key>
    <integer>900</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>WorkingDirectory</key>
    <string>OSTLER_HOME</string>
    <key>StandardOutPath</key>
    <string>OSTLER_LOGS/settling-refresh.log</string>
    <key>StandardErrorPath</key>
    <string>OSTLER_LOGS/settling-refresh.err</string>
    <key>ProcessType</key>
    <string>Background</string>
    <key>Nice</key>
    <integer>5</integer>
</dict>
</plist>
